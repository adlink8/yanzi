{
  "name": "stefanie-sun-deep-reads",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3008",
    "build": "next build",
    "start": "next start -p 3008",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:cf": "npx @cloudflare/next-on-pages@1 && rm -f .vercel/output/static/_worker.js/nop-build-log.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=dot",
    "audit:catalog": "node scripts/audit-catalog-normalization.mjs",
    "audit:content": "node scripts/audit-content-issues.mjs",
    "remediate:mv": "node scripts/remediate-mv-links.mjs",
    "worklist:album": "node scripts/generate-album-reclassify-worklist.mjs",
    "audit:style": "node scripts/audit-deepread-style.mjs",
    "report:deepread-quality": "node scripts/report-deepread-quality.mjs",
    "prepare:deepread-batches": "node scripts/prepare-deepread-batches.mjs",
    "prepare:deepread-depth": "node scripts/prepare-deepread-depth-batches.mjs",
    "verify:deepread-batch": "node scripts/verify-deepread-batch.mjs",
    "gate:content": "node scripts/validate-content-gate.mjs",
    "ci": "npm run typecheck && npm run lint && npm run test:ci && npm run audit:catalog && npm run gate:content"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "gray-matter": "4.0.3",
    "marked": "15.0.7",
    "next": "15.2.4",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.2.4",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.2",
    "vitest": "^4.1.4"
  }
}
