# OpenAI-compatible API (required for song/album AI Q&A)
# Prefer cloud providers (OpenAI, DeepSeek, 智谱 GLM, etc.).
# Local Ollama is optional only — override BASE_URL if you need it.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Feedback → GitHub Issues (optional)
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_OWNER=
GITHUB_FEEDBACK_REPO=
GITHUB_FEEDBACK_LABELS=feedback,from-site

# Optional browser fallback webhook for feedback
# NEXT_PUBLIC_FEEDBACK_WEBHOOK_URL=
